# Copy to .env.local and fill in to override the free default services.
# None of these are needed to run the app locally.

# Valhalla /route endpoint. For Stadia Maps use https://api.stadiamaps.com/route/v1
EXPO_PUBLIC_ROUTING_URL=
# Photon geocoder base URL (serves /api and /reverse)
EXPO_PUBLIC_GEOCODER_URL=
# Vector tiles in the OpenMapTiles schema (TileJSON URL)
EXPO_PUBLIC_TILES_URL=
EXPO_PUBLIC_GLYPHS_URL=
# Sent as ?api_key= to the routing and geocoding services (Stadia Maps style)
EXPO_PUBLIC_MAPS_API_KEY=
